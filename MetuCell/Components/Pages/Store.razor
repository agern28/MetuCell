@page "/store"
@inject MetuCell.Services.DatabaseService DbService
@inject MetuCell.Services.AppState AppState
@inject NavigationManager NavManager

<style>
    .store-hero { background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border: 1px solid var(--border); border-radius: 24px; padding: 28px 30px; margin-bottom: 28px; box-shadow: var(--shadow); }
    .store-hero h1 { color: var(--accent); font-weight: 800; margin: 0; font-size: 1.5rem; }
    .store-hero p { color: var(--text-muted); margin: 4px 0 0; }
    .pkt-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; }
    .pkt { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 22px; display: flex; flex-direction: column; gap: 10px; transition: .2s; }
    .pkt:hover { transform: translateY(-3px); border-color: var(--accent); }
    .pkt .type { align-self: flex-start; font-size: .72rem; font-weight: 800; letter-spacing: .5px; padding: 3px 10px; border-radius: 999px; text-transform: uppercase; }
    .pkt .type.post { background: rgba(34,211,238,.12); color: var(--accent); }
    .pkt .type.pre  { background: rgba(52,211,153,.12); color: var(--good); }
    .pkt .fee { font-family: 'Sora', sans-serif; font-weight: 800; font-size: 1.5rem; color: #fff; }
    .pkt .row-q { display: flex; justify-content: space-between; font-size: .88rem; color: var(--text-muted); }
    .pkt .row-q b { color: var(--text); }
    .intl { font-size: .76rem; color: var(--gold); }
    .line-picker { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 18px 22px; margin-bottom: 24px; }
    .line-picker label { display: block; font-weight: 700; color: var(--text-muted); margin-bottom: 8px; }
</style>

<div class="animate__animated animate__fadeIn">
    <div class="store-hero">
        <h1><i class="bi bi-bag-fill"></i> Package Store</h1>
        <p>@AppState.LoggedInName — add a new package to your line (@AppState.LoggedInPhone).</p>
    </div>

    @if (AppState.IsBusiness && lines.Count > 0)
    {
        <div class="line-picker">
            <label><i class="bi bi-person-lines-fill"></i> Which line should we add the package to?</label>
            <select class="form-select" @bind="targetPhone">
                @foreach (var l in lines)
                {
                    <option value="@l.Phone">@l.FirstName @l.LastName — @l.Phone@(l.Phone == AppState.LoggedInPhone ? " (your line)" : "")</option>
                }
            </select>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5"><div class="spinner-border text-info"></div></div>
    }
    else
    {
        @if (Message != null)
        {
            <div class="alert @(isError ? "alert-danger" : "alert-success") fw-bold animate__animated animate__fadeIn">@Message</div>
        }

        <div class="pkt-grid">
            @foreach (var p in packets)
            {
                <div class="pkt">
                    <span class="type @(p.PlanType == "Post-Paid" ? "post" : "pre")">@p.PlanType</span>
                    <div class="fee">@p.Fee.ToString("0") ₺</div>
                    <div class="row-q"><span>Internet</span><b>@p.InternetSize MB</b></div>
                    <div class="row-q"><span>SMS</span><b>@p.SmsCount</b></div>
                    <div class="row-q"><span>Minutes</span><b>@p.MinuteCount</b></div>
                    @if (p.International) { <div class="intl"><i class="bi bi-globe"></i> International usage included</div> }
                    <button class="btn btn-primary mt-2" @onclick="() => Buy(p)" disabled="@busy">
                        <i class="bi bi-cart-check"></i> Buy
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    List<MetuCell.Services.PacketCatalogItem> packets = new();
    List<MetuCell.Services.CorporateLine> lines = new();
    string targetPhone;
    bool isLoading = true, busy = false, isError = false;
    string Message;

    protected override async Task OnInitializedAsync()
    {
        // Sadece musteri (admin degil) erisebilir.
        if (!AppState.IsLoggedIn) { NavManager.NavigateTo("/login"); return; }
        if (AppState.IsAdmin) { NavManager.NavigateTo("admin"); return; }

        targetPhone = AppState.LoggedInPhone;                 // varsayilan: kendi hatti
        if (AppState.IsBusiness)                              // kurumsal -> sirket hatlarini getir
            lines = await DbService.GetCorporateLinesAsync(AppState.CustomerId);

        packets = await DbService.GetBuyablePacketsAsync();
        isLoading = false;
    }

    async Task Buy(MetuCell.Services.PacketCatalogItem p)
    {
        busy = true; Message = null; isError = false;
        var phone = string.IsNullOrEmpty(targetPhone) ? AppState.LoggedInPhone : targetPhone;
        try
        {
            await DbService.PurchasePacketAsync(phone, p.PacketId);
            Message = $"✅ Done! The {p.PlanType} package has been added to {phone}.";
        }
        catch (Exception ex) { isError = true; Message = "Error: " + ex.Message; }
        finally { busy = false; }
    }
}
