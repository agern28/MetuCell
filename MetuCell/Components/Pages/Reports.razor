@page "/reports"
@using MetuCell.Models
@inject MetuCell.Services.DatabaseService Db
@inject MetuCell.Services.AppState AppState
@inject NavigationManager Nav

<style>
    .crm-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 20px;
        color: white;
    }

    .crm-input {
        background: #0f172a;
        border: 1px solid #334155;
        color: white;
        border-radius: 8px;
        padding: 8px;
        margin-right: 10px;
    }

    .title-teal {
        color: #22d3ee;
        font-weight: bold;
        margin-bottom: 15px;
        font-size: 1.1rem;
    }
</style>

@if (AppState.IsLoggedIn)
{
    <div class="container-fluid animate__animated animate__fadeIn">
        <h2 style="color: #22d3ee; font-weight: 800; margin-bottom: 30px;">CRM & Reports</h2>

        <div class="row">
            <!-- Query (c): Gift-Eligible Lines (cooldown passed) -->
            <div class="col-md-6">
                <div class="crm-card">
                    <div class="title-teal">(c) Gift-Eligible Lines (cooldown passed)</div>
                    <button class="btn btn-success btn-sm fw-bold mb-3" @onclick="GetEligible">List Eligible Lines</button>
                    @if (eligibleLines != null)
                    {
                        <ul class="text-secondary small">@foreach (var l in eligibleLines) {
                            <li>@l</li>
                        }
                    </ul>
                    }
                </div>
            </div>
            <!-- Query (b): Business User List -->
            <div class="col-md-6">
                <div class="crm-card">
                    <div class="title-teal">(b) Business Line Users</div>
                    <div class="d-flex mb-3">
                        <input type="number" class="crm-input" @bind="busId" placeholder="Customer ID (e.g. 1)" />
                        <button class="btn btn-info btn-sm fw-bold" @onclick="GetUsers">Run</button>
                    </div>
                    @if (users != null)
                    {
                        <ul class="text-secondary small">@foreach(var u in users) {
                            <li>@u.FirstName @u.LastName</li>
                        }
                    </ul>
                }
            </div>
        </div>

        <!-- Query (f): Total Bill Calculation -->
        <div class="col-md-6">
            <div class="crm-card">
                <div class="title-teal">(f) Total Bill Amount (Post-Paid)</div>
                <div class="d-flex mb-3">
                    <input type="number" class="crm-input" @bind="custId" placeholder="Customer ID" />
                    <button class="btn btn-warning btn-sm fw-bold text-dark" @onclick="CalcTotal">Calculate</button>
                </div>
                @if (totalFee > -1)
                {
                    <div class="text-warning fw-bold fs-5">Total: @totalFee TL</div>
                }
            </div>
        </div>

        <!-- Query (d): PUK ve SIM Bilgisi -->
        <div class="col-md-6">
            <div class="crm-card">
                <div class="title-teal">(d) Locked Line Recovery (PUK & SIM TYPE)</div>
                <div class="d-flex mb-3">
                    <input type="text" class="crm-input" @bind="phoneSearch" placeholder="Phone No (532...)" />
                    <button class="btn btn-primary btn-sm fw-bold" @onclick="GetSimInfo">Run</button>
                </div>
                @if (simInfo != null)
                {
                    <div class="text-white fw-bold">@simInfo</div>
                }
            </div>
        </div>

        <!-- Query (e) & Transaction: Expiring Packages -->
        <div class="col-md-6">
            <div class="crm-card">
                <div class="title-teal">(e) Expiring in 3 Days & Cleanup</div>
                <button class="btn btn-outline-info btn-sm fw-bold mb-3" @onclick="GetExpiring">Fetch Alert List (3 Days)</button>
                <button class="btn btn-danger btn-sm fw-bold mb-3 ms-2" @onclick="CleanExpired">Delete Expired</button>

                @if (expiringLines != null)
                {
                    <ul class="text-danger small">@foreach(var l in expiringLines) {
                        <li>@l (alert will be sent)</li>
                    }
                </ul>
            }
            @if (cleanMessage != null)
            {
                <div class="text-success small fw-bold mt-2">@cleanMessage</div>
            }
        </div>
    </div>
</div>
</div>
}

@code {
    int busId, custId;
    string phoneSearch, simInfo, cleanMessage;
    decimal totalFee = -1;
    List<UserReport> users;
    List<string> expiringLines;
    List<string> eligibleLines;

    protected override void OnInitialized() { if (!AppState.IsLoggedIn) Nav.NavigateTo("/login"); }

    async Task GetUsers() => users = await Db.GetBusinessUsersAsync(busId);
    async Task GetEligible() => eligibleLines = await Db.GetEligibleLinesForGiftAsync();
    async Task CalcTotal() => totalFee = await Db.GetTotalMonthlyFeeAsync(custId);
    async Task GetSimInfo() => simInfo = await Db.GetSimDetailsAsync(phoneSearch);
    async Task GetExpiring() => expiringLines = await Db.GetExpiringLinesAsync();

    async Task CleanExpired()
    {
        await Db.DeleteExpiredPacketsAsync();
        cleanMessage = "All expired packages have been deleted from the database!";
    }
}