@page "/reports"
@using MetuCell.Models
@inject MetuCell.Services.DatabaseService Db
@inject MetuCell.Services.AppState AppState
@inject NavigationManager Nav

<style>
    .crm-card { background: #1e293b; border: 1px solid #334155; border-radius: 15px; padding: 20px; margin-bottom: 20px; color: white; }
    .crm-input { background: #0f172a; border: 1px solid #334155; color: white; border-radius: 8px; padding: 8px; margin-right: 10px; }
    .title-teal { color: #22d3ee; font-weight: bold; margin-bottom: 15px; font-size: 1.1rem; }
</style>

@if (AppState.IsLoggedIn)
{
    <div class="container-fluid animate__animated animate__fadeIn">
        <h2 style="color: #22d3ee; font-weight: 800; margin-bottom: 30px;">CRM & Raporlar Ekranı</h2>
        
        <div class="row">
            <!-- Query (b): Kurumsal Kullanıcı Listesi -->
            <div class="col-md-6">
                <div class="crm-card">
                    <div class="title-teal">(b) Kurumsal Hat Kullanıcıları</div>
                    <div class="d-flex mb-3">
                        <input type="number" class="crm-input" @bind="busId" placeholder="Müşteri ID (Örn: 1)" />
                        <button class="btn btn-info btn-sm fw-bold" @onclick="GetUsers">Sorgula</button>
                    </div>
                    @if (users != null) { <ul class="text-secondary small">@foreach(var u in users) { <li>@u.FirstName @u.LastName</li> } </ul> }
                </div>
            </div>

            <!-- Query (f): Toplam Fatura Hesaplama -->
            <div class="col-md-6">
                <div class="crm-card">
                    <div class="title-teal">(f) Toplam Fatura Tutarı (Post-Paid)</div>
                    <div class="d-flex mb-3">
                        <input type="number" class="crm-input" @bind="custId" placeholder="Müşteri ID" />
                        <button class="btn btn-warning btn-sm fw-bold text-dark" @onclick="CalcTotal">Hesapla</button>
                    </div>
                    @if (totalFee > -1) { <div class="text-warning fw-bold fs-5">Toplam: @totalFee TL</div> }
                </div>
            </div>

            <!-- Query (d): PUK ve SIM Bilgisi -->
            <div class="col-md-6">
                <div class="crm-card">
                    <div class="title-teal">(d) Kilitli Hat (PUK & SIM TYPE) Kurtarma</div>
                    <div class="d-flex mb-3">
                        <input type="text" class="crm-input" @bind="phoneSearch" placeholder="Tel No (532...)" />
                        <button class="btn btn-primary btn-sm fw-bold" @onclick="GetSimInfo">Sorgula</button>
                    </div>
                    @if (simInfo != null) { <div class="text-white fw-bold">@simInfo</div> }
                </div>
            </div>

            <!-- Query (e) & Transaction: Süresi Biten Paketler -->
            <div class="col-md-6">
                <div class="crm-card">
                    <div class="title-teal">(e) Son 3 Günü Kalanlar & Temizlik</div>
                    <button class="btn btn-outline-info btn-sm fw-bold mb-3" @onclick="GetExpiring">Uyarı Listesini Çek (3 Gün)</button>
                    <button class="btn btn-danger btn-sm fw-bold mb-3 ms-2" @onclick="CleanExpired">Süresi Dolanları Sil</button>
                    
                    @if (expiringLines != null) { <ul class="text-danger small">@foreach(var l in expiringLines) { <li>@l (Uyarı Gönderilecek)</li> } </ul> }
                    @if (cleanMessage != null) { <div class="text-success small fw-bold mt-2">@cleanMessage</div> }
                </div>
            </div>
        </div>
    </div>
}

@code {
    int busId, custId;
    string phoneSearch, simInfo, cleanMessage;
    decimal totalFee = -1;
    List<UserReport> users;
    List<string> expiringLines;

    protected override void OnInitialized() { if (!AppState.IsLoggedIn) Nav.NavigateTo("/login"); }

    async Task GetUsers() => users = await Db.GetBusinessUsersAsync(busId);
    async Task CalcTotal() => totalFee = await Db.GetTotalMonthlyFeeAsync(custId);
    async Task GetSimInfo() => simInfo = await Db.GetSimDetailsAsync(phoneSearch);
    async Task GetExpiring() => expiringLines = await Db.GetExpiringLinesAsync();
    
    async Task CleanExpired() {
        await Db.DeleteExpiredPacketsAsync();
        cleanMessage = "Süresi geçmiş tüm paketler veritabanından silindi!";
    }
}