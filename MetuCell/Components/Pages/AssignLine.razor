@page "/assign-line"
@inject MetuCell.Services.DatabaseService DbService
@inject MetuCell.Services.AppState AppState
@inject NavigationManager NavManager

<style>
    .assign-card { background: var(--card); border: 1px solid var(--border); border-radius: 22px; padding: 36px; max-width: 720px; margin: 0 auto; box-shadow: var(--shadow); }
    .sec-label { color: var(--accent); font-weight: 800; letter-spacing: .4px; }
    .seg { display: flex; gap: 10px; }
    .seg button { flex: 1; padding: 11px; border-radius: 12px; font-weight: 700; border: 1px solid var(--border); background: var(--bg-0); color: var(--text-muted); cursor: pointer; transition: .2s; }
    .seg button.on { background: rgba(34,211,238,.12); border-color: var(--accent); color: var(--accent); }
</style>

@if (!AppState.IsLoggedIn || !AppState.IsAdmin)
{
    <div class="text-center mt-5"><div class="spinner-border text-info"></div></div>
}
else
{
    <div class="assign-card animate__animated animate__fadeInUp">
        <h3 class="fw-bold mb-1" style="color: var(--accent);"><i class="bi bi-sim-fill"></i> Add Line to Existing Customer</h3>
        <p class="text-secondary mb-4">A new SIM + phone number is generated. SIM ID, PUK and number are assigned automatically.</p>

        <div class="row g-3">
            <div class="col-md-6"><label>Customer ID</label><input type="number" class="form-control" @bind="CustomerId" placeholder="e.g. 1" /></div>
        </div>

        <hr class="my-4" />
        <div class="sec-label mb-2"><i class="bi bi-sim"></i> SIM Details</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label>Network Range</label>
                <select class="form-select" @bind="NetworkRange">
                    <option value="2G">2G</option><option value="3G">3G</option><option value="4G">4G</option><option value="5G">5G</option>
                </select>
            </div>
            <div class="col-md-6">
                <label>SIM Type</label>
                <select class="form-select" @bind="SimType">
                    <option value="Standard">Standard</option><option value="Micro">Micro</option><option value="Nano">Nano</option><option value="eSIM">eSIM</option>
                </select>
            </div>
        </div>

        <hr class="my-4" />
        <div class="sec-label mb-2"><i class="bi bi-person-vcard"></i> Who is this number for?</div>
        <div class="seg mb-3">
            <button class="@(ForSelf ? "on" : "")" @onclick="() => ForSelf = true"><i class="bi bi-person-check"></i> The customer themselves</button>
            <button class="@(ForSelf ? "" : "on")" @onclick="() => ForSelf = false"><i class="bi bi-people"></i> Another user</button>
        </div>

        @if (ForSelf)
        {
            <p class="text-secondary small"><i class="bi bi-info-circle"></i> User details are taken automatically from the customer's own record (individual customers only).</p>
        }
        else
        {
            <div class="row g-3">
                <div class="col-md-6"><label>TRNC ID</label><input class="form-control" @bind="TrnId" /></div>
                <div class="col-md-6"><label>Date of Birth</label><input type="date" class="form-control" @bind="Dob" /></div>
                <div class="col-md-6"><label>First Name</label><input class="form-control" @bind="FirstName" /></div>
                <div class="col-md-6"><label>Last Name</label><input class="form-control" @bind="LastName" /></div>
                <div class="col-md-6">
                    <label>Gender</label>
                    <select class="form-select" @bind="Gender">
                        <option value="Male">Male</option><option value="Female">Female</option><option value="Other">Other</option>
                    </select>
                </div>
            </div>
        }

        <button class="btn btn-primary w-100 mt-4 py-2" @onclick="Provision" disabled="@busy">
            @(busy ? "Processing..." : "CREATE LINE")
        </button>

        @if (Message != null)
        {
            <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3 mb-0 fw-bold text-center">@Message</div>
        }
    </div>
}

@code {
    int CustomerId = 0;
    string NetworkRange = "5G", SimType = "eSIM";
    bool ForSelf = false;
    string TrnId = "", FirstName = "", LastName = "", Gender = "Male";
    DateTime Dob = DateTime.Today.AddYears(-20);
    bool busy = false, isError = false;
    string Message = null;

    protected override void OnInitialized()
    {
        if (!AppState.IsLoggedIn) NavManager.NavigateTo("/login");
        else if (!AppState.IsAdmin) NavManager.NavigateTo(""); // sadece yonetici
    }

    async Task Provision()
    {
        isError = false; Message = null;
        if (CustomerId <= 0) { isError = true; Message = "Enter a valid Customer ID."; return; }
        if (!ForSelf && (string.IsNullOrWhiteSpace(TrnId) || string.IsNullOrWhiteSpace(FirstName)))
        { isError = true; Message = "TRNC ID and First Name are required for a new user."; return; }

        busy = true;
        try
        {
            var phone = await DbService.ProvisionLineForCustomerAsync(
                CustomerId, NetworkRange, SimType, ForSelf, TrnId, FirstName, LastName, Gender, Dob);
            Message = $"✅ Line created. New number: {phone}";
            TrnId = FirstName = LastName = "";
        }
        catch (Exception ex) { isError = true; Message = "Error: " + ex.Message; }
        finally { busy = false; }
    }
}
