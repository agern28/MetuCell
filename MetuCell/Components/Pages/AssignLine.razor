@page "/assign-line"
@inject MetuCell.Services.DatabaseService DbService
@inject MetuCell.Services.AppState AppState
@inject NavigationManager NavManager

<style>
    .assign-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 22px;
        padding: 38px;
        max-width: 680px;
        margin: 0 auto;
        box-shadow: var(--shadow);
    }

    .sec-label {
        color: var(--accent);
        font-weight: 800;
        letter-spacing: .5px;
    }
</style>

@if (!AppState.IsLoggedIn)
{
    <div class="text-center mt-5"><div class="spinner-border text-info"></div></div>
}
else
{
    <div class="assign-card animate__animated animate__fadeInUp">
        <h3 class="fw-bold mb-1" style="color: var(--accent);"><i class="bi bi-sim-fill"></i> Yeni Hat Provizyonu</h3>
        <p class="text-secondary mb-4">Bir SIM kartı ve telefon numarasını, fiilen kullanacak kişiye (Actual User) tanımlayın.</p>

        <div class="row g-3">
            <div class="col-md-6"><label>Telefon Numarası</label><input class="form-control" @bind="Phone" placeholder="5321234567" /></div>
            <div class="col-md-6"><label>Bağlanacak SIM ID</label><input type="number" class="form-control" @bind="SimId" placeholder="Örn: 5009" /></div>
        </div>

        <hr class="my-4" />
        <div class="sec-label mb-3"><i class="bi bi-person-vcard"></i> Kullanıcı (Actual User) Bilgileri</div>

        <div class="row g-3">
            <div class="col-md-6"><label>Kimlik No (TRNC ID)</label><input class="form-control" @bind="TrnId" placeholder="11 haneli" /></div>
            <div class="col-md-6"><label>Doğum Tarihi</label><input type="date" class="form-control" @bind="Dob" /></div>
            <div class="col-md-6"><label>Ad</label><input class="form-control" @bind="FirstName" /></div>
            <div class="col-md-6"><label>Soyad</label><input class="form-control" @bind="LastName" /></div>
            <div class="col-md-6">
                <label>Cinsiyet</label>
                <select class="form-select" @bind="Gender">
                    <option value="Male">Erkek</option>
                    <option value="Female">Kadın</option>
                    <option value="Other">Diğer</option>
                </select>
            </div>
            <div class="col-md-6"><label>Kullanıcı Şifresi</label><input type="password" class="form-control" @bind="Password" placeholder="Hat self-servis şifresi" /></div>
        </div>

        <button class="btn btn-primary w-100 mt-4 py-2" @onclick="ProvisionLine" disabled="@isLoading">
            @(isLoading ? "İşleniyor..." : "HATTI AKTİVE ET")
        </button>

        @if (Message != null)
        {
            <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3 mb-0 fw-bold text-center">@Message</div>
        }
    </div>
}

@code {
    string Phone = "";
    int SimId = 0;
    string TrnId = "", FirstName = "", LastName = "", Gender = "Male", Password = "";
    DateTime Dob = DateTime.Today.AddYears(-20);
    bool isLoading = false, isError = false;
    string Message = null;

    protected override void OnInitialized()
    {
        if (!AppState.IsLoggedIn) NavManager.NavigateTo("/login");
    }

    async Task ProvisionLine()
    {
        if (string.IsNullOrWhiteSpace(Phone) || SimId <= 0 || string.IsNullOrWhiteSpace(TrnId)
            || string.IsNullOrWhiteSpace(FirstName) || string.IsNullOrWhiteSpace(Password))
        {
            isError = true; Message = "Lütfen tüm zorunlu alanları doldurun (şifre dâhil)!"; return;
        }

        isLoading = true; Message = null;
        try
        {
            await DbService.ProvisionMobileLineAsync(Phone, SimId, TrnId, FirstName, LastName, Gender, Dob, Password);
            isError = false;
            Message = "✅ Hat başarıyla provizyonlandı ve kullanıcı oluşturuldu!";
            Phone = ""; SimId = 0; TrnId = ""; FirstName = ""; LastName = ""; Password = "";
        }
        catch (Exception ex)
        {
            isError = true; Message = "Hata: " + ex.Message;
        }
        finally { isLoading = false; }
    }
}
