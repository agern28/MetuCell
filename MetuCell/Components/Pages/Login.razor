@page "/login"
@inject MetuCell.Services.DatabaseService DbService
@inject MetuCell.Services.AppState AppState
@inject NavigationManager NavManager

<style>
    .login-wrap { display: flex; align-items: center; justify-content: center; min-height: 72vh; }
    .login-card {
        width: 100%; max-width: 430px;
        background: var(--card); border: 1px solid var(--border);
        border-radius: 26px; padding: 38px 34px; box-shadow: var(--shadow);
        position: relative; overflow: hidden;
    }
    .login-card::before {
        content: ""; position: absolute; top: -60px; right: -60px;
        width: 180px; height: 180px; border-radius: 50%;
        background: radial-gradient(circle, rgba(34,211,238,.22), transparent 70%);
    }
    .login-logo {
        font-family: 'Sora', sans-serif; font-weight: 800; font-size: 1.9rem;
        color: var(--accent); letter-spacing: 2px; text-align: center;
        text-shadow: 0 0 26px rgba(34,211,238,.4);
    }
    .login-sub { color: var(--text-muted); text-align: center; margin-bottom: 22px; font-size: .92rem; }

    .mode-seg { display: flex; gap: 8px; margin-bottom: 22px; }
    .mode-seg button {
        flex: 1; padding: 10px; border-radius: 12px; font-weight: 700; font-size: .88rem;
        border: 1px solid var(--border); background: var(--bg-0); color: var(--text-muted);
        cursor: pointer; transition: .2s; display: flex; align-items: center; justify-content: center; gap: 6px;
    }
    .mode-seg button.on { background: rgba(34,211,238,.12); border-color: var(--accent); color: var(--accent); }
    .mode-seg button.on.admin { background: rgba(251,191,36,.12); border-color: var(--gold); color: var(--gold); }

    .field-icon { position: relative; }
    .field-icon i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); }
    .field-icon .form-control { padding-left: 42px; }
    .hint { font-size: .76rem; color: #64748b; text-align: center; margin-top: 16px; }
</style>

<div class="login-wrap">
    <div class="login-card animate__animated animate__fadeInUp">
        <div class="login-logo">MetuCell</div>
        <p class="login-sub">Sign in to the Digital Operations Center</p>

        <div class="mode-seg">
            <button class="@(IsAdminMode ? "" : "on")" @onclick="() => SetMode(false)">
                <i class="bi bi-person"></i> Customer
            </button>
            <button class="@(IsAdminMode ? "on admin" : "")" @onclick="() => SetMode(true)">
                <i class="bi bi-shield-lock"></i> Admin
            </button>
        </div>

        @if (!IsAdminMode)
        {
            <div class="field-icon mb-3">
                <i class="bi bi-telephone"></i>
                <input type="text" class="form-control" @bind="Phone" placeholder="Phone Number" />
            </div>
        }
        else
        {
            <div class="field-icon mb-3">
                <i class="bi bi-person-badge"></i>
                <input type="text" class="form-control" @bind="Username" placeholder="Admin Username" />
            </div>
        }

        <div class="field-icon mb-4">
            <i class="bi bi-lock"></i>
            <input type="password" class="form-control" @bind="Password" placeholder="Password" @onkeyup="OnKey" />
        </div>

        <button class="btn @(IsAdminMode ? "btn-warning" : "btn-primary") w-100 p-3 fw-bold fs-6"
                @onclick="DoLogin" disabled="@busy">
            @(busy ? "Checking..." : (IsAdminMode ? "ADMIN LOGIN" : "LOG IN"))
        </button>

        @if (ErrorMessage != null)
        {
            <div class="alert alert-danger mt-3 mb-0 text-center fw-bold">@ErrorMessage</div>
        }

    </div>
</div>

@code {
    bool IsAdminMode = false;
    string Phone = "";
    string Username = "";
    string Password = "";
    string ErrorMessage;
    bool busy = false;

    // Yonetici girisi uygulama icinde sabit tutulur (orijinal veritabani degistirilmez öyle olacak).
    const string ADMIN_USER = "admin";
    const string ADMIN_PASS = "Admin!2026";

    void SetMode(bool admin)
    {
        IsAdminMode = admin;
        ErrorMessage = null;
        Password = "";
    }

    async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoLogin();
    }

    async Task DoLogin()
    {
        ErrorMessage = null;
        busy = true;
        try
        {
            if (IsAdminMode)
            {
                // Yonetici girisi uygulama icinde sabittir (veritabani degisikligi yok).
                if (Username == ADMIN_USER && Password == ADMIN_PASS)
                {
                    AppState.LoginAdmin("System Administrator");
                    NavManager.NavigateTo("admin");
                }
                else ErrorMessage = "Incorrect admin username or password!";
            }
            else
            {
                var res = await DbService.LoginAsync(Phone, Password);
                if (res != null)
                {
                    AppState.LoginUser(Phone, res.DisplayName, res.CustomerId, res.IsBusiness);
                    NavManager.NavigateTo("");
                }
                else ErrorMessage = "Incorrect phone number or password!";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Connection error: " + ex.Message;
        }
        finally { busy = false; }
    }
}
