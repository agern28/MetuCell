@page "/add-customer"
@inject MetuCell.Services.DatabaseService DbService
@inject MetuCell.Services.AppState AppState
@inject NavigationManager NavManager

<style>
    .crm-shell {
        max-width: 720px;
        margin: 0 auto;
    }

    .crm-panel {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 22px;
        padding: 34px;
        box-shadow: var(--shadow);
    }

    .panel-title {
        font-weight: 800;
        color: var(--accent);
        margin-bottom: 4px;
    }

    .panel-desc {
        color: var(--text-muted);
        font-size: .9rem;
        margin-bottom: 26px;
    }

    .seg {
        display: flex;
        gap: 10px;
        margin-bottom: 24px;
    }

        .seg button {
            flex: 1;
            padding: 12px;
            border-radius: 12px;
            font-weight: 700;
            border: 1px solid var(--border);
            background: var(--bg-0);
            color: var(--text-muted);
            cursor: pointer;
            transition: .2s;
        }

            .seg button.on {
                background: rgba(34,211,238,.12);
                border-color: var(--accent);
                color: var(--accent);
            }
</style>

<div class="crm-shell animate__animated animate__fadeIn">
    <div class="crm-panel">
        <h3 class="panel-title"><i class="bi bi-person-plus-fill"></i> Yeni Müşteri Kaydı</h3>
        <p class="panel-desc">Faturadan sorumlu hesap sahibini (Account Owner) sisteme tanımlayın.</p>

        <div class="seg">
            <button class="@(CustomerType == "Individual" ? "on" : "")" @onclick='() => CustomerType = "Individual"'>
                <i class="bi bi-person"></i> Bireysel
            </button>
            <button class="@(CustomerType == "Business" ? "on" : "")" @onclick='() => CustomerType = "Business"'>
                <i class="bi bi-building"></i> Kurumsal
            </button>
        </div>

        <div class="row g-3">
            <div class="col-md-8"><label>Adres</label><input class="form-control" @bind="Address" /></div>
            <div class="col-md-4"><label>E-posta</label><input class="form-control" @bind="Email" /></div>
            <div class="col-md-6"><label>Hesap Şifresi</label><input type="password" class="form-control" @bind="Password" placeholder="Müşteri portal şifresi" /></div>
        </div>

        <hr class="my-4" />

        @if (CustomerType == "Individual")
        {
            <div class="row g-3">
                <div class="col-md-6"><label>TRNC ID</label><input class="form-control" @bind="TrncId" /></div>
                <div class="col-md-6"><label>Doğum Tarihi</label><input class="form-control" type="date" @bind="Dob" /></div>
                <div class="col-md-6"><label>Ad</label><input class="form-control" @bind="FirstName" /></div>
                <div class="col-md-6"><label>Soyad</label><input class="form-control" @bind="LastName" /></div>
                <div class="col-md-6">
                    <label>Cinsiyet</label>
                    <select class="form-select" @bind="Gender">
                        <option value="Male">Erkek</option>
                        <option value="Female">Kadın</option>
                        <option value="Other">Diğer</option>
                    </select>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-md-12"><label>Şirket Adı</label><input class="form-control" @bind="CompanyName" /></div>
                <div class="col-md-6"><label>Vergi No</label><input class="form-control" @bind="TaxNumber" /></div>
                <div class="col-md-6"><label>Ticaret Sicil No</label><input class="form-control" @bind="BusinessNumber" /></div>
            </div>
        }

        <button class="btn btn-primary mt-4 px-4 py-2" @onclick="SaveCustomer" disabled="@busy">
            @(busy ? "Kaydediliyor..." : "Sisteme Kaydet")
        </button>

        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3 mb-0 fw-bold">@Message</div>
        }
    </div>
</div>

@code {
    string CustomerType = "Individual";
    string Address = "", Email = "", Password = "", Message;
    string TrncId = "", FirstName = "", LastName = "", Gender = "Male";
    string CompanyName = "", TaxNumber = "", BusinessNumber = "";
    DateTime Dob = DateTime.Today.AddYears(-25);
    bool busy = false, isError = false;

    protected override void OnInitialized()
    {
        if (!AppState.IsLoggedIn) NavManager.NavigateTo("/login");
    }

    async Task SaveCustomer()
    {
        isError = false; Message = null;

        if (string.IsNullOrWhiteSpace(Address) || string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Password))
        { isError = true; Message = "Adres, e-posta ve şifre zorunludur."; return; }

        busy = true;
        try
        {
            if (CustomerType == "Individual")
            {
                if (string.IsNullOrWhiteSpace(TrncId) || string.IsNullOrWhiteSpace(FirstName))
                { isError = true; Message = "TRNC ID ve Ad zorunludur."; return; }

                await DbService.AddIndividualCustomerAsync(Address, Email, Password, TrncId, FirstName, LastName, Gender, Dob);
            }
            else
            {
                if (string.IsNullOrWhiteSpace(CompanyName) || string.IsNullOrWhiteSpace(TaxNumber))
                { isError = true; Message = "Şirket adı ve vergi no zorunludur."; return; }

                // DOGRU SIRA: (address, email, password, businessNo, taxNo, companyName)
                await DbService.AddBusinessCustomerAsync(Address, Email, Password, BusinessNumber, TaxNumber, CompanyName);
            }
            Message = "✅ Müşteri başarıyla eklendi!";
            Address = Email = Password = TrncId = FirstName = LastName = "";
            CompanyName = TaxNumber = BusinessNumber = "";
        }
        catch (Exception ex)
        {
            isError = true; Message = "Hata: " + ex.Message;
        }
        finally { busy = false; }
    }
}
