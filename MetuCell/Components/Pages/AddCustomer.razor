@page "/add-customer"
@inject MetuCell.Services.DatabaseService DbService
@inject MetuCell.Services.AppState AppState
@inject NavigationManager NavManager

<style>
    .crm-shell { max-width: 760px; margin: 0 auto; }
    .crm-panel { background: var(--card); border: 1px solid var(--border); border-radius: 22px; padding: 34px; box-shadow: var(--shadow); }
    .panel-title { font-weight: 800; color: var(--accent); margin-bottom: 4px; }
    .panel-desc { color: var(--text-muted); font-size: .9rem; margin-bottom: 26px; }
    .seg { display: flex; gap: 10px; margin-bottom: 24px; }
    .seg button { flex: 1; padding: 12px; border-radius: 12px; font-weight: 700; border: 1px solid var(--border); background: var(--bg-0); color: var(--text-muted); cursor: pointer; transition: .2s; }
    .seg button.on { background: rgba(34,211,238,.12); border-color: var(--accent); color: var(--accent); }
    .sec-label { color: var(--accent); font-weight: 800; letter-spacing: .4px; }
</style>

<div class="crm-shell animate__animated animate__fadeIn">
    <div class="crm-panel">
        <h3 class="panel-title"><i class="bi bi-person-plus-fill"></i> New Customer Registration</h3>
        <p class="panel-desc">When the account holder is created, the first SIM and line are automatically provisioned.</p>

        <div class="seg">
            <button class="@(CustomerType=="Individual"?"on":"")" @onclick='() => CustomerType="Individual"'>
                <i class="bi bi-person"></i> Individual
            </button>
            <button class="@(CustomerType=="Business"?"on":"")" @onclick='() => CustomerType="Business"'>
                <i class="bi bi-building"></i> Business
            </button>
        </div>

        <div class="row g-3">
            <div class="col-md-8"><label>Address</label><input class="form-control" @bind="Address" /></div>
            <div class="col-md-4"><label>Email</label><input class="form-control" @bind="Email" /></div>
            <div class="col-md-6"><label>Account Password</label><input type="password" class="form-control" @bind="Password" placeholder="Login password" /></div>
        </div>

        <hr class="my-4" />

        @if (CustomerType == "Individual")
        {
            <div class="row g-3">
                <div class="col-md-6"><label>TRNC ID</label>
                    <div class="input-group">
                        <input type="@(ShowTrnInd ? "text" : "password")" class="form-control" @bind="TrncId" />
                        <button class="btn btn-outline-secondary" type="button" tabindex="-1" @onclick="() => ShowTrnInd = !ShowTrnInd">
                            <i class="bi @(ShowTrnInd ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-6"><label>Date of Birth</label><input class="form-control" type="date" @bind="Dob" /></div>
                <div class="col-md-6"><label>First Name</label><input class="form-control" @bind="FirstName" /></div>
                <div class="col-md-6"><label>Last Name</label><input class="form-control" @bind="LastName" /></div>
                <div class="col-md-6">
                    <label>Gender</label>
                    <select class="form-select" @bind="Gender">
                        <option value="Male">Male</option><option value="Female">Female</option><option value="Other">Other</option>
                    </select>
                </div>
            </div>
            <p class="text-secondary small mt-3 mb-0"><i class="bi bi-info-circle"></i> The first line is opened directly under the customer's own name (user = customer).</p>
        }
        else
        {
            <div class="row g-3">
                <div class="col-md-12"><label>Company Name</label><input class="form-control" @bind="CompanyName" /></div>
                <div class="col-md-6"><label>Tax Number</label><input class="form-control" @bind="TaxNumber" /></div>
                <div class="col-md-6"><label>Business Reg. Number</label><input class="form-control" @bind="BusinessNumber" /></div>
            </div>
            <hr class="my-4" />
            <div class="sec-label mb-2"><i class="bi bi-person-vcard"></i> First Line User (Employee / Authorized)</div>
            <div class="row g-3">
                <div class="col-md-6"><label>Employee TRNC ID</label>
                    <div class="input-group">
                        <input type="@(ShowTrnEmp ? "text" : "password")" class="form-control" @bind="EmpTrnc" />
                        <button class="btn btn-outline-secondary" type="button" tabindex="-1" @onclick="() => ShowTrnEmp = !ShowTrnEmp">
                            <i class="bi @(ShowTrnEmp ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-6"><label>Date of Birth</label><input class="form-control" type="date" @bind="EmpDob" /></div>
                <div class="col-md-6"><label>First Name</label><input class="form-control" @bind="EmpFirst" /></div>
                <div class="col-md-6"><label>Last Name</label><input class="form-control" @bind="EmpLast" /></div>
                <div class="col-md-6">
                    <label>Gender</label>
                    <select class="form-select" @bind="EmpGender">
                        <option value="Male">Male</option><option value="Female">Female</option><option value="Other">Other</option>
                    </select>
                </div>
            </div>
        }

        <hr class="my-4" />
        <div class="sec-label mb-2"><i class="bi bi-sim"></i> SIM Details (remaining values auto-assigned)</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label>Network Range</label>
                <select class="form-select" @bind="NetworkRange">
                    <option value="2G">2G</option><option value="3G">3G</option>
                    <option value="4G">4G</option><option value="5G">5G</option>
                </select>
            </div>
            <div class="col-md-6">
                <label>SIM Type</label>
                <select class="form-select" @bind="SimType">
                    <option value="Standard">Standard</option><option value="Micro">Micro</option>
                    <option value="Nano">Nano</option><option value="eSIM">eSIM</option>
                </select>
            </div>
        </div>

        <button class="btn btn-primary mt-4 px-4 py-2" @onclick="SaveCustomer" disabled="@busy">
            @(busy ? "Saving..." : "Create Customer and First Line")
        </button>

        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3 mb-0 fw-bold">@Message</div>
        }
    </div>
</div>

@code {
    string CustomerType = "Individual";
    string Address = "", Email = "", Password = "", Message;
    bool ShowTrnInd = false, ShowTrnEmp = false; // sensitive: TRNC ID input is masked by default with a reveal toggle
    // Bireysel
    string TrncId = "", FirstName = "", LastName = "", Gender = "Male";
    DateTime Dob = DateTime.Today.AddYears(-25);
    // Kurumsal
    string CompanyName = "", TaxNumber = "", BusinessNumber = "";
    string EmpTrnc = "", EmpFirst = "", EmpLast = "", EmpGender = "Male";
    DateTime EmpDob = DateTime.Today.AddYears(-30);
    // SIM
    string NetworkRange = "5G", SimType = "eSIM";
    bool busy = false, isError = false;

    protected override void OnInitialized()
    {
        if (!AppState.IsLoggedIn) NavManager.NavigateTo("/login");
        else if (!AppState.IsAdmin) NavManager.NavigateTo(""); // sadece yonetici
    }

    async Task SaveCustomer()
    {
        isError = false; Message = null;
        if (string.IsNullOrWhiteSpace(Address) || string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Password))
        { isError = true; Message = "Address, email and password are required."; return; }

        busy = true;
        try
        {
            string phone;
            if (CustomerType == "Individual")
            {
                if (string.IsNullOrWhiteSpace(TrncId) || string.IsNullOrWhiteSpace(FirstName))
                { isError = true; Message = "TRNC ID and First Name are required."; busy = false; return; }

                phone = await DbService.AddIndividualCustomerAsync(
                    Address, Email, Password, TrncId, FirstName, LastName, Gender, Dob, NetworkRange, SimType);
            }
            else
            {
                if (string.IsNullOrWhiteSpace(CompanyName) || string.IsNullOrWhiteSpace(TaxNumber) || string.IsNullOrWhiteSpace(EmpTrnc) || string.IsNullOrWhiteSpace(EmpFirst))
                { isError = true; Message = "Company name, tax number and first employee details are required."; busy = false; return; }

                phone = await DbService.AddBusinessCustomerAsync(
                    Address, Email, Password, BusinessNumber, TaxNumber, CompanyName,
                    NetworkRange, SimType, EmpTrnc, EmpFirst, EmpLast, EmpGender, EmpDob);
            }

            Message = $"Customer created and first line assigned. New number: {phone}";
            Address = Email = Password = TrncId = FirstName = LastName = "";
            CompanyName = TaxNumber = BusinessNumber = EmpTrnc = EmpFirst = EmpLast = "";
        }
        catch (Exception ex) { isError = true; Message = "Error: " + ex.Message; }
        finally { busy = false; }
    }
}
